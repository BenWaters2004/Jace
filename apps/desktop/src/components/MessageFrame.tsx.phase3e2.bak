import { useState } from "react";
import type { ReactNode } from "react";

interface MessageFrameProps {
  role: "user" | "assistant";
  content: string;
  createdAt?: string | null;
  model?: string | null;
  streaming?: boolean;
  stopped?: boolean;
  agentHandoff?: boolean;
  children: ReactNode;
}

const LONG_MESSAGE_CHARACTERS = 1800;
const LONG_MESSAGE_LINES = 24;

function isLongMessage(content: string) {
  if (content.length >= LONG_MESSAGE_CHARACTERS) return true;
  return content.split("\n").length >= LONG_MESSAGE_LINES;
}

function formatTimestamp(value?: string | null) {
  if (!value) return null;

  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return null;

  try {
    return new Intl.DateTimeFormat(undefined, {
      day: "numeric",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
    }).format(parsed);
  } catch {
    return parsed.toLocaleString();
  }
}

async function copyText(value: string) {
  if (!value) return false;

  try {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return true;
    }
  } catch {
    // Fall through to the legacy desktop-safe copy path.
  }

  try {
    const textarea = document.createElement("textarea");
    textarea.value = value;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    textarea.style.pointerEvents = "none";
    document.body.appendChild(textarea);
    textarea.select();
    const copied = document.execCommand("copy");
    textarea.remove();
    return copied;
  } catch {
    return false;
  }
}

function modelLabel(model?: string | null, agentHandoff?: boolean) {
  if (agentHandoff) return "Agent handoff";
  if (!model) return null;

  const trimmed = model.trim();
  if (!trimmed) return null;

  return trimmed.length > 42 ? `${trimmed.slice(0, 39)}…` : trimmed;
}

function CopyIcon({ copied }: { copied: boolean }) {
  if (copied) {
    return (
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M4.5 10.4 8.1 14l7.4-8" />
      </svg>
    );
  }

  return (
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <rect x="7" y="7" width="9" height="9" rx="2" />
      <path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-7A1.5 1.5 0 0 0 3 5.5v7A1.5 1.5 0 0 0 4.5 14H7" />
    </svg>
  );
}

export function MessageFrame(props: MessageFrameProps) {
  const [copied, setCopied] = useState(false);
  const [collapsed, setCollapsed] = useState(false);

  const timestamp = formatTimestamp(props.createdAt);
  const displayModel =
    props.role === "assistant"
      ? modelLabel(props.model, props.agentHandoff)
      : null;
  const canCollapse =
    props.role === "assistant" &&
    !props.streaming &&
    isLongMessage(props.content);
  const hasActions = Boolean(props.content) && !props.streaming;

  async function handleCopy() {
    const success = await copyText(props.content);
    if (!success) return;

    setCopied(true);
    window.setTimeout(() => setCopied(false), 1400);
  }

  return (
    <div
      className={`message-frame message-frame-${props.role} ${
        collapsed ? "message-frame-collapsed" : ""
      }`}
    >
      <div
        className={`message-surface ${
          props.role === "user"
            ? "message-surface-user"
            : "message-surface-assistant"
        }`}
      >
        <div className="message-frame-content">{props.children}</div>
        {collapsed && <div className="message-collapse-fade" aria-hidden="true" />}
      </div>

      {(timestamp || displayModel || props.stopped || canCollapse || hasActions) && (
        <div className="message-action-bar">
          <div className="message-action-leading">
            {hasActions && (
              <button
                type="button"
                className="message-copy-control"
                onClick={handleCopy}
                title={copied ? "Copied" : "Copy message"}
                aria-label={copied ? "Message copied" : "Copy message"}
              >
                <CopyIcon copied={copied} />
              </button>
            )}

            <div className="message-action-meta">
              {timestamp && <span>{timestamp}</span>}
              {displayModel && <span title={props.model ?? undefined}>{displayModel}</span>}
              {props.stopped && <span className="message-action-stopped">Stopped</span>}
            </div>
          </div>

          {canCollapse && (
            <div className="message-action-secondary">
              <button
                type="button"
                onClick={() => setCollapsed((value) => !value)}
                aria-expanded={!collapsed}
                title={collapsed ? "Expand response" : "Collapse long response"}
              >
                {collapsed ? "Expand" : "Collapse"}
              </button>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
