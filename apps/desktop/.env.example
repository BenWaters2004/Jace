# ------------------------------------------------------------
# Jace Desktop Runtime
# ------------------------------------------------------------

# local
#   Desktop connects to a Jace Core running on this machine.
#
# server
#   Desktop connects to a remote Jace Core.
VITE_JACE_MODE=local

# Default local Jace Core.
VITE_JACE_API_URL=http://127.0.0.1:8000

# Optional.
#
# If omitted, Jace derives the WebSocket endpoint automatically:
#
# http://  -> ws://
# https:// -> wss://
#
# VITE_JACE_WS_URL=ws://127.0.0.1:8000