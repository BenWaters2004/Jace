# JACE_4BS2_ENV
# ---------------------------------------------------------------------------
# Phase 4B.S2 - Jace Core runtime
# ---------------------------------------------------------------------------
JACE_MODE=local
JACE_HOST=127.0.0.1
JACE_PORT=8000
JACE_SERVER_NAME=Jace Core
JACE_PUBLIC_URL=
JACE_DATABASE_URL=
JACE_CORS_ALLOWED_ORIGINS=

# JACE_4BS3_AUTH_ENV
JACE_AUTH_ENABLED=true
JACE_AUTH_ACCESS_TOKEN_MINUTES=30
JACE_AUTH_REFRESH_TOKEN_DAYS=30
JACE_AUTH_PASSWORD_MIN_LENGTH=12
JACE_AUTH_BOOTSTRAP_TOKEN=

# JACE_4BS4_DEVICE_ENV
JACE_DEVICE_PAIRING_MINUTES=10
JACE_DEVICE_ONLINE_WINDOW_SECONDS=90

# JACE_4BS5_DEVICE_SOCKET_ENV
JACE_DEVICE_SOCKET_HEARTBEAT_SECONDS=20
JACE_DEVICE_SOCKET_HELLO_TIMEOUT_SECONDS=15




JACE_DEFAULT_MODEL=qwen3.5:4b
JACE_EMBEDDING_MODEL=qwen3-embedding:0.6b
JACE_MEMORY_EXTRACTION_MODEL=qwen3.5:4b
JACE_OLLAMA_BASE_URL=http://127.0.0.1:11434
JACE_REQUEST_TIMEOUT_SECONDS=180

# v0.5.1 performance
JACE_OLLAMA_KEEP_ALIVE=-1m
JACE_EMBEDDING_KEEP_ALIVE=20m
JACE_PRELOAD_DEFAULT_MODEL=true
JACE_PRELOAD_TIMEOUT_SECONDS=120
JACE_OLLAMA_NUM_CTX=8192
JACE_HISTORY_MAX_MESSAGES=20
JACE_HISTORY_MAX_CHARS=10000
JACE_MEMORY_SMART_RETRIEVAL=true
JACE_MEMORY_EXTRACTION_IDLE_SECONDS=4

# Memory
JACE_MEMORY_ENABLED=true
JACE_MEMORY_AUTO_EXTRACT=true
JACE_MEMORY_TOP_K=6
JACE_MEMORY_MIN_SIMILARITY=0.50
JACE_MEMORY_MAX_CANDIDATES=5
JACE_MEMORY_MIN_IMPORTANCE=0.55
JACE_MEMORY_MIN_CONFIDENCE=0.70
JACE_MEMORY_RECONCILE_LIMIT=5
JACE_MEMORY_RECONCILE_MIN_SIMILARITY=0.55
JACE_MEMORY_FORGET_MIN_SIMILARITY=0.60

# Tools / web
JACE_TOOLS_ENABLED=true
JACE_SMART_TOOL_ROUTING=true
JACE_MAX_TOOL_STEPS=7
JACE_TOOL_APPROVAL_TIMEOUT_SECONDS=300
JACE_TOOL_RESULT_MAX_CHARS=8000
JACE_TOOL_AUDIT_PREVIEW_CHARS=1500
# 0 = stream tool turns immediately, -1 = buffer the whole turn (old behaviour)
JACE_TOOL_STREAM_BUFFER_CHARS=160
JACE_WEB_ENABLED=true
JACE_BROWSER_ENABLED=true

# Phase 6 computer access
JACE_COMPUTER_ENABLED=true
JACE_COMPUTER_ALLOW_SENSITIVE_FILES=false
JACE_COMPUTER_MAX_READ_BYTES=1000000
JACE_COMPUTER_MAX_WRITE_CHARS=200000
JACE_COMPUTER_SEARCH_MAX_FILES=1500
JACE_COMPUTER_COMMAND_OUTPUT_CHARS=12000
JACE_COMPUTER_COMMAND_INHERIT_ENVIRONMENT=false
JACE_COMPUTER_COMMAND_MAX_TIMEOUT_SECONDS=900

# Phase 7 multimodal
JACE_MULTIMODAL_ENABLED=true
JACE_ATTACHMENT_MAX_COUNT=6
JACE_ATTACHMENT_IMAGE_MAX_BYTES=12000000
JACE_ATTACHMENT_DOCUMENT_MAX_BYTES=25000000
JACE_ATTACHMENT_AUDIO_MAX_BYTES=75000000
JACE_ATTACHMENT_TEXT_MAX_CHARS=14000
JACE_ATTACHMENT_MODEL_IMAGE_MAX_EDGE=1600
JACE_ATTACHMENT_PDF_RENDER_PAGES=3
JACE_ATTACHMENT_PDF_RENDER_SCALE=1.35
# Leave blank to use the active conversation model. qwen3.5:4b already supports images.
JACE_VISION_MODEL=

# Audio uses a local faster-whisper model. Runtime is offline/local-only by default.
JACE_AUDIO_ENABLED=true
JACE_AUDIO_MODEL=base
JACE_AUDIO_DEVICE=cpu
JACE_AUDIO_COMPUTE_TYPE=int8
JACE_AUDIO_BEAM_SIZE=3
JACE_AUDIO_LOCAL_FILES_ONLY=true

JACE_SCREEN_CAPTURE_ENABLED=true
JACE_SCREEN_CAPTURE_MAX_EDGE=1920

# Phase 8 automation
JACE_AUTOMATION_ENABLED=true
JACE_AUTOMATION_SCHEDULER_TIMEZONE=Europe/London
JACE_AUTOMATION_MISFIRE_GRACE_SECONDS=3600
JACE_AUTOMATION_MAX_PARALLEL_RUNS=2
JACE_AUTOMATION_DEFAULT_TIMEOUT_SECONDS=300
JACE_AUTOMATION_MAX_TIMEOUT_SECONDS=1800
JACE_AUTOMATION_MAX_TOOL_STEPS=6
JACE_AUTOMATION_RUN_HISTORY_LIMIT=200
JACE_AUTOMATION_NOTIFICATION_POLL_SECONDS=10
JACE_AUTOMATION_MAX_RESULT_CHARS=20000
JACE_AUTOMATION_WATCHER_STATE_CHARS=10000

# Phase 9 interactive GUI control (Windows-first)
JACE_INTERACTIVE_CONTROL_ENABLED=true
JACE_INTERACTIVE_DEFAULT_MAX_STEPS=30
JACE_INTERACTIVE_MAX_STEPS=80
JACE_INTERACTIVE_SESSION_TIMEOUT_SECONDS=1800
JACE_INTERACTIVE_ACTION_PAUSE_MS=220
JACE_INTERACTIVE_TYPE_INTERVAL_MS=18
JACE_INTERACTIVE_AUTO_CAPTURE_AFTER_ACTION=true
JACE_INTERACTIVE_CAPTURE_MAX_EDGE=1600
JACE_INTERACTIVE_STORE_SCREENSHOTS_DEFAULT=false
JACE_INTERACTIVE_MAX_TEXT_CHARS=4000
JACE_INTERACTIVE_MAX_HOTKEY_KEYS=5

# Phase 10B voice latency
JACE_VOICE_STT_BEAM_SIZE=1
JACE_VOICE_STT_VAD_FILTER=true
JACE_VOICE_STT_VAD_MIN_SILENCE_MS=300
JACE_VOICE_STT_CONDITION_ON_PREVIOUS_TEXT=false
JACE_VOICE_WARM_TTS_ON_STATUS=true

JACE_AGENT_ENABLED=true
JACE_AGENT_MAX_PARALLEL=2
JACE_AGENT_MAX_TOOL_STEPS=7
JACE_AGENT_TIMEOUT_SECONDS=900
JACE_AGENT_CONTEXT_MESSAGES=10
JACE_AGENT_RESULT_MAX_CHARS=30000
JACE_AGENT_EVENT_HISTORY_LIMIT=400

# C5A Cloud Agents: all six explicit routes required when enabled.
# Do not activate until cloud tool calls and provider privacy have been tested.
JACE_AGENT_CLOUD_ROUTING_ENABLED=false
JACE_AGENT_ROUTE_DIRECTOR=
JACE_AGENT_ROUTE_RESEARCH=
JACE_AGENT_ROUTE_CODE=
JACE_AGENT_ROUTE_FILES=
JACE_AGENT_ROUTE_ANALYST=
JACE_AGENT_ROUTE_GENERAL=

JACE_GOOGLE_CLIENT_ID=
JACE_GOOGLE_CLIENT_SECRET=

JACE_MICROSOFT_CLIENT_ID=
JACE_MICROSOFT_TENANT=common

JACE_GITHUB_CLIENT_ID=

# JACE_4BS7_MODEL_GATEWAY_ENV
# Routes use provider:model syntax. Blank values inherit the existing model
# settings, so Ollama remains the default local provider.
JACE_MODEL_GATEWAY_DEFAULT_PROVIDER=ollama
JACE_MODEL_ROUTE_CONVERSATION_FAST=
JACE_MODEL_ROUTE_REASONING_HIGH=
JACE_MODEL_ROUTE_CODING_HIGH=
JACE_MODEL_ROUTE_VISION=
JACE_MODEL_ROUTE_RESEARCH_HIGH=
JACE_MODEL_ROUTE_LOCAL_PRIVATE=
JACE_MODEL_ROUTE_MEMORY_EXTRACT=
JACE_MODEL_ROUTE_EMBEDDING=
JACE_MODEL_ROUTE_RERANKING=

# JACE_4BS8_PRIVACY_GATEWAY_ENV
JACE_PRIVACY_ENABLED=true
JACE_PRIVACY_CLOUD_EGRESS_ENABLED=false
JACE_PRIVACY_DEFAULT_CLASSIFICATION=internal

# JACE_4B3A_RUNTIME_EVENT_ENV
JACE_RUNTIME_EVENTS_PERSIST=true
JACE_RUNTIME_EVENT_RETENTION_DAYS=30
JACE_RUNTIME_EVENT_REPLAY_LIMIT=500
JACE_RUNTIME_EVENT_SUBSCRIBER_QUEUE=512

# JACE_4B3B1_PROCESS_RUNTIME_ENV
JACE_PROCESS_RUNTIME_ENABLED=true
JACE_PROCESS_OUTPUT_MAX_BYTES=2097152
JACE_PROCESS_COMMAND_MAX_CHARS=50000
JACE_PROCESS_START_ACK_TIMEOUT_SECONDS=10
JACE_PROCESS_MAX_TIMEOUT_SECONDS=86400

# JACE_4B3B2_TERMINAL_RUNTIME_ENV
JACE_TERMINAL_RUNTIME_ENABLED=true
JACE_TERMINAL_OUTPUT_MAX_BYTES=4194304
JACE_TERMINAL_INPUT_MAX_CHARS=20000
JACE_TERMINAL_START_ACK_TIMEOUT_SECONDS=10

# PHASE C1: Cloud providers — disabled unless credentials and privacy egress are explicitly enabled.
# Only set real keys in backend/.env on the server (never in Git).
JACE_OPENAI_API_KEY=
JACE_ANTHROPIC_API_KEY=
JACE_CLOUD_MAX_OUTPUT_TOKENS=2048
# C2A safe opt-in. Leave false until credentials, billing, privacy and model IDs are verified.
JACE_CLOUD_CHAT_CUTOVER=false
# C2B: hybrid searches cloud vectors plus older memories lexically.
# Do not set the embeddings route to Anthropic: its current adapter has no embed API.
# JACE_MODEL_ROUTE_MEMORY_EXTRACT=anthropic:<verified-model-id>
# JACE_MODEL_ROUTE_EMBEDDING=openai:text-embedding-3-small
JACE_MEMORY_RETRIEVAL_MODE=semantic
JACE_MEMORY_LEXICAL_MIN_SIMILARITY=0.60
# C3A: opt-in Auto (Jace) mode; only configured tier routes are selectable.
# The existing conversation.fast route is the required fallback.
JACE_SMART_ROUTING_ENABLED=false
# C3B: opt-in observed provider health and pre-output retry.
JACE_CLOUD_RELIABILITY_ENABLED=false
JACE_CLOUD_RETRY_COUNT=1
JACE_CLOUD_CIRCUIT_FAILURE_THRESHOLD=3
JACE_CLOUD_CIRCUIT_COOLDOWN_SECONDS=45
# 0 means no in-process per-route rate guard.
JACE_CLOUD_REQUESTS_PER_MINUTE=0
# Optional manually verified USD rates PER 1 MILLION tokens. No hard-coded prices.
JACE_CLOUD_PRICING_JSON={}
# 0 disables the soft, observed, process-local budget gate.
JACE_CLOUD_OBSERVED_COST_LIMIT_USD=0
# Only Auto-selected requests may switch to fast if the selected circuit is open.
JACE_CLOUD_AUTO_FAST_FALLBACK=false
# C4A: manual/explicit cross-provider editorial review. Default OFF.
JACE_COLLABORATION_ENABLED=false
# C4B.1: manual review of user-supplied evidence; no retrieval/verification.
JACE_COLLABORATION_EVIDENCE_ENABLED=false
# C4B.2: retrieval is opt-in and existing read-tool permissions must be Allow.
JACE_COLLABORATION_RETRIEVAL_ENABLED=false
JACE_COLLABORATION_RETRIEVAL_TIMEOUT_SECONDS=150
# C4C.1: off by default; uses existing recorded workspace tool evidence only.
JACE_DIRECTOR_CROSS_REVIEW_ENABLED=false
# C4C.2: source-aware coordination; supersedes C4C.1 review when enabled.
JACE_DIRECTOR_COORDINATED_REVIEW_ENABLED=false
# C4C.3: requires database migration (new table created at next Core startup).
JACE_DIRECTOR_DURABLE_HANDOFFS_ENABLED=false
# C4C.3B: requires durable handoffs + database backup and single Core worker.
JACE_DIRECTOR_WORKFLOW_CHECKPOINTS_ENABLED=false
# C4C.3C: single Core worker; quarantine tool-active tasks on restart/crash.
JACE_AGENT_SAFE_RECOVERY_ENABLED=false
# Different cloud providers required. Replace placeholders with real enabled model IDs.
# JACE_COLLABORATION_DRAFTER_ROUTE=openai:your-model-id
# JACE_COLLABORATION_REVIEWER_ROUTE=anthropic:your-model-id
JACE_COLLABORATION_MAX_OUTPUT_CHARS=12000
JACE_COLLABORATION_TIMEOUT_SECONDS=120
# JACE_MODEL_ROUTE_CONVERSATION_BALANCED=anthropic:<verified-model-id>
# JACE_MODEL_ROUTE_REASONING_HIGH=openai:<verified-model-id>
# JACE_MODEL_ROUTE_CODING_HIGH=anthropic:<verified-model-id>
# JACE_MODEL_ROUTE_RESEARCH_HIGH=openai:<verified-model-id>
# Example: JACE_MODEL_ROUTE_CONVERSATION_FAST=openai:gpt-6-luna
# Example: JACE_MODEL_ROUTE_REASONING_HIGH=anthropic:claude-sonnet-5-5
# Do not switch global default provider until old conversation model selectors are migrated.
# Set JACE_PRIVACY_CLOUD_EGRESS_ENABLED=true only after reviewing the privacy policy.
