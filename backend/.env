JACE_DEFAULT_MODEL=qwen3.5:4b
JACE_EMBEDDING_MODEL=qwen3-embedding:0.6b
JACE_MEMORY_EXTRACTION_MODEL=qwen3.5:4b
JACE_OLLAMA_BASE_URL=http://127.0.0.1:11434
JACE_REQUEST_TIMEOUT_SECONDS=180

# v0.5.1 performance
JACE_OLLAMA_KEEP_ALIVE=-1m
JACE_EMBEDDING_KEEP_ALIVE=20m
JACE_PRELOAD_DEFAULT_MODEL=true
JACE_PRELOAD_TIMEOUT_SECONDS=120
JACE_OLLAMA_NUM_CTX=8192
JACE_HISTORY_MAX_MESSAGES=20
JACE_HISTORY_MAX_CHARS=10000
JACE_MEMORY_SMART_RETRIEVAL=true
JACE_MEMORY_EXTRACTION_IDLE_SECONDS=4

# Memory
JACE_MEMORY_ENABLED=true
JACE_MEMORY_AUTO_EXTRACT=true
JACE_MEMORY_TOP_K=6
JACE_MEMORY_MIN_SIMILARITY=0.50
JACE_MEMORY_MAX_CANDIDATES=5
JACE_MEMORY_MIN_IMPORTANCE=0.55
JACE_MEMORY_MIN_CONFIDENCE=0.70
JACE_MEMORY_RECONCILE_LIMIT=5
JACE_MEMORY_RECONCILE_MIN_SIMILARITY=0.55
JACE_MEMORY_FORGET_MIN_SIMILARITY=0.60

# Tools / web
JACE_TOOLS_ENABLED=true
JACE_SMART_TOOL_ROUTING=true
JACE_MAX_TOOL_STEPS=7
JACE_TOOL_APPROVAL_TIMEOUT_SECONDS=300
JACE_TOOL_RESULT_MAX_CHARS=8000
JACE_TOOL_AUDIT_PREVIEW_CHARS=1500
# 0 = stream tool turns immediately, -1 = buffer the whole turn (old behaviour)
JACE_TOOL_STREAM_BUFFER_CHARS=160
JACE_WEB_ENABLED=true
JACE_BROWSER_ENABLED=true

# Phase 6 computer access
JACE_COMPUTER_ENABLED=true
JACE_COMPUTER_ALLOW_SENSITIVE_FILES=false
JACE_COMPUTER_MAX_READ_BYTES=1000000
JACE_COMPUTER_MAX_WRITE_CHARS=200000
JACE_COMPUTER_SEARCH_MAX_FILES=1500
JACE_COMPUTER_COMMAND_OUTPUT_CHARS=12000
JACE_COMPUTER_COMMAND_INHERIT_ENVIRONMENT=false
JACE_COMPUTER_COMMAND_MAX_TIMEOUT_SECONDS=900

# Phase 7 multimodal
JACE_MULTIMODAL_ENABLED=true
JACE_ATTACHMENT_MAX_COUNT=6
JACE_ATTACHMENT_IMAGE_MAX_BYTES=12000000
JACE_ATTACHMENT_DOCUMENT_MAX_BYTES=25000000
JACE_ATTACHMENT_AUDIO_MAX_BYTES=75000000
JACE_ATTACHMENT_TEXT_MAX_CHARS=14000
JACE_ATTACHMENT_MODEL_IMAGE_MAX_EDGE=1600
JACE_ATTACHMENT_PDF_RENDER_PAGES=3
JACE_ATTACHMENT_PDF_RENDER_SCALE=1.35
# Leave blank to use the active conversation model. qwen3.5:4b already supports images.
JACE_VISION_MODEL=

# Audio uses a local faster-whisper model. Runtime is offline/local-only by default.
JACE_AUDIO_ENABLED=true
JACE_AUDIO_MODEL=base
JACE_AUDIO_DEVICE=cpu
JACE_AUDIO_COMPUTE_TYPE=int8
JACE_AUDIO_BEAM_SIZE=3
JACE_AUDIO_LOCAL_FILES_ONLY=true

JACE_SCREEN_CAPTURE_ENABLED=true
JACE_SCREEN_CAPTURE_MAX_EDGE=1920

# Phase 8 automation
JACE_AUTOMATION_ENABLED=true
JACE_AUTOMATION_SCHEDULER_TIMEZONE=Europe/London
JACE_AUTOMATION_MISFIRE_GRACE_SECONDS=3600
JACE_AUTOMATION_MAX_PARALLEL_RUNS=2
JACE_AUTOMATION_DEFAULT_TIMEOUT_SECONDS=300
JACE_AUTOMATION_MAX_TIMEOUT_SECONDS=1800
JACE_AUTOMATION_MAX_TOOL_STEPS=6
JACE_AUTOMATION_RUN_HISTORY_LIMIT=200
JACE_AUTOMATION_NOTIFICATION_POLL_SECONDS=10
JACE_AUTOMATION_MAX_RESULT_CHARS=20000
JACE_AUTOMATION_WATCHER_STATE_CHARS=10000

# Phase 9 interactive GUI control (Windows-first)
JACE_INTERACTIVE_CONTROL_ENABLED=true
JACE_INTERACTIVE_DEFAULT_MAX_STEPS=30
JACE_INTERACTIVE_MAX_STEPS=80
JACE_INTERACTIVE_SESSION_TIMEOUT_SECONDS=1800
JACE_INTERACTIVE_ACTION_PAUSE_MS=220
JACE_INTERACTIVE_TYPE_INTERVAL_MS=18
JACE_INTERACTIVE_AUTO_CAPTURE_AFTER_ACTION=true
JACE_INTERACTIVE_CAPTURE_MAX_EDGE=1600
JACE_INTERACTIVE_STORE_SCREENSHOTS_DEFAULT=false
JACE_INTERACTIVE_MAX_TEXT_CHARS=4000
JACE_INTERACTIVE_MAX_HOTKEY_KEYS=5

# Phase 10B voice latency
JACE_VOICE_STT_BEAM_SIZE=1
JACE_VOICE_STT_VAD_FILTER=true
JACE_VOICE_STT_VAD_MIN_SILENCE_MS=300
JACE_VOICE_STT_CONDITION_ON_PREVIOUS_TEXT=false
JACE_VOICE_WARM_TTS_ON_STATUS=true

JACE_AGENT_ENABLED=true
JACE_AGENT_MAX_PARALLEL=2
JACE_AGENT_MAX_TOOL_STEPS=7
JACE_AGENT_TIMEOUT_SECONDS=900
JACE_AGENT_CONTEXT_MESSAGES=10
JACE_AGENT_RESULT_MAX_CHARS=30000
JACE_AGENT_EVENT_HISTORY_LIMIT=400